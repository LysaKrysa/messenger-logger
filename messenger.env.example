# Copy outside the checkout as ../messenger.env, then chmod 600 it.
# Docker env-file syntax: no export and no extra outer quotes around JSON.
# Replace every placeholder before starting the listener.

FB_SESSION_JSON={"c_user":"YOUR_NUMERIC_ACCOUNT_ID","xs":"YOUR_XS_COOKIE","datr":"YOUR_DATR_COOKIE"}
LOGGER_E2EE=true
LOGGER_TIMEZONE=Europe/Warsaw
LOGGER_MEDIA_MAX_MB=25

# Optional forwarding. Disabled until explicitly enabled.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=deleted
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_TOPICS=false
TELEGRAM_SEND_MEDIA=true
TELEGRAM_VIEW_ONCE=false

# Container-internal defaults; host folders are configured by bind mounts.
DATA_DIR=/data
BRIDGE_BIN=/usr/local/bin/messenger-bridge

# Standalone relay language. Shared-bot users choose with /en or /pl.
TELEGRAM_LANGUAGE=pl
